# Address of your SellFlow API (no trailing slash). Required.
VITE_API_URL=https://sellflowapi.onrender.com

# Your public website address, used for canonical links and share previews.
VITE_SITE_URL=https://www.example.com

# Shown on the "Connect WhatsApp" step so merchants can reach you (use either or both).
# International format, digits only, e.g. 2348012345678
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=

# Optional: Google Search Console verification token (HTML tag method).
VITE_GSC_VERIFICATION=
